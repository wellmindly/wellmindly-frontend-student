# Google OAuth Client ID for Student Portal (replace with your Google Web Client ID)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API URL (default local: http://localhost:5000/api)
VITE_API_URL=http://localhost:5000/api

# Feature Flags
VITE_ENABLE_WRITEMINDLY=true

# Google Analytics 4 (GA4) Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Microsoft Clarity Project ID (e.g. abcdef1234)
VITE_CLARITY_PROJECT_ID=
